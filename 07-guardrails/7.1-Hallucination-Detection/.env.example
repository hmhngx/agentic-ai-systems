# The detector runs fully offline by default. Everything below is OPTIONAL and
# only consulted when you enable the LLM judge (USE_LLM=1) or the live --pdf
# naive-RAG bridge.

# --- OpenRouter (optional: LLM-as-a-judge for Check 1, and the live RAG) ---
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Set to 1 to replace the string-overlap support signal with an NLI judge.
USE_LLM=0

# --- Scoring policy overrides (optional; defaults shown) ---
# Refuse (serve the fallback) when the groundedness score is below this.
GROUNDEDNESS_THRESHOLD=0.5
# Composition weights. Must sum to 1.0.
GROUNDEDNESS_W_SUPPORT=0.60
GROUNDEDNESS_W_CITATION=0.25
GROUNDEDNESS_W_RETRIEVAL=0.15

# --- Qdrant (optional: only the live --pdf naive-RAG bridge needs it) ---
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=naive_rag_chunks

# Live --pdf ingestion only. Set to 1 to skip tiktoken's one-time cl100k_base
# BPE download (which can hang on slow/restricted networks) and use a fast
# len//4 token estimate instead. Only nudges chunk boundaries, never changes
# answer correctness. Leave at 0 to keep exact tiktoken counts.
FAST_TOKENIZE=0
