# Day 5 - Advanced RAG environment variables.
# Copy this file to .env and fill in the keys you have. The benchmark
# will degrade gracefully if COHERE_API_KEY is missing (reranker is
# skipped, hybrid and baseline still run).

# ---------------------------------------------------------------------------
# Dense embeddings (REQUIRED)
# ---------------------------------------------------------------------------
# OpenRouter is the actual embedding provider used by dense_retriever.py
# and ground_truth.py. The Day 3 chunks_hnsw collection was built with
# text-embedding-3-small (1536-dim); changing the model here would
# break vector-dimension compatibility with that collection.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# Cohere reranker (OPTIONAL but recommended)
# ---------------------------------------------------------------------------
# Used by src/reranker.py to call the cross-encoder Rerank API
# (model = rerank-v3.5). If absent, the reranker pipeline falls back
# to the top-5 from the RRF fusion stage and the benchmark notes
# "reranker unavailable" in the pipeline name.
COHERE_API_KEY=your-cohere-api-key-here

# Trial keys: ~10 rerank calls/minute. Default spacing keeps the 20-query
# benchmark from hitting 429. Set to 0 with a Production key.
COHERE_RERANK_MIN_INTERVAL_SEC=6.5
# Minimum wait after a 429 even when MIN_INTERVAL_SEC=0 (Trial key safety).
COHERE_RERANK_429_MIN_BACKOFF_SEC=6.5
COHERE_RERANK_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Voyage embeddings (RESERVED - not used by current source code)
# ---------------------------------------------------------------------------
# Declared per the Day 5 spec for forward compatibility. The current
# dense path does not call the Voyage API - leave blank unless you are
# adapting dense_retriever.py to Voyage embeddings (which would also
# require rebuilding chunks_hnsw at Voyage's vector dimension).
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Qdrant connection
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# COLLECTION_NAME must match Day 3's collection exactly.
# If Day 3 used a different name, update here.
# The collection must already be populated with 500 chunks.
COLLECTION_NAME=chunks_hnsw
