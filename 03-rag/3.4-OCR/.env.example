# Embedding API — provide one of these:
VOYAGE_API_KEY=your-voyage-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# Qdrant
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=doc_ingest_ocr

# Docling settings
HF_HOME=./.hf_cache          # controls where HuggingFace models are cached
DOCLING_ENABLE_OCR=false      # set true for scanned PDFs (slower)

# Pipeline settings
CHUNK_SIZE_TOKENS=300         # target tokens per prose chunk
CHUNK_OVERLAP_TOKENS=30       # overlap between prose chunks
TABLE_MAX_ROWS_PER_CHUNK=20   # max rows before splitting large tables

# Verification (smoke-test queries)
# VERIFICATION_ADAPTIVE=true   # derive Q1–Q5 from ingested chunks (default)
# VERIFICATION_ADAPTIVE=false  # use legacy fixed queries for sample_pdfs/
# VERIFICATION_FIND_TABLE_QUERY=find the table about target version  # optional Q3 override
