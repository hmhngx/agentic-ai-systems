{
  "name": "mcp-ts-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Day 7 — Elite MCP stdio server exposing three tools (sqlite_query, file_read, calc) with strict Zod schemas, typed output, and structured error handling.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "tsx src/seed.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "mcp-inspector node --import tsx src/index.ts",
    "inspect:cli": "mcp-inspector --cli node --import tsx src/index.ts --method tools/list",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
