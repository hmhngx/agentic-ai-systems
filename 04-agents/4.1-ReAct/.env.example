OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Max completion tokens per LLM call (lower if you see HTTP 402 credit errors)
OPENROUTER_MAX_TOKENS=128
# Shorter system prompt for free-tier prompt token limits (1=on, 0=full schemas)
OPENROUTER_COMPACT_PROMPT=1
OPENROUTER_MAX_HISTORY_TURNS=1
OPENROUTER_MAX_OBS_CHARS=280

# Web tool: search (default) = real DuckDuckGo via web_search; mock = LLM-simulated web_mock
REACT_WEB_MODE=search
# WEB_SEARCH_TIMEOUT_SECONDS=12

# OPENROUTER_MODEL options (in order of preference for ReAct):
#   anthropic/claude-sonnet-4-5  — best instruction following, reliable JSON output
#   openai/gpt-4o                — strong structured output
#   meta-llama/llama-3.3-70b-instruct — free tier option, weaker JSON adherence
#
# ReAct requires a model that:
#   1. Reliably generates Thought:/Action:/FINAL ANSWER: format
#   2. Outputs valid JSON for tool calls
#   3. Respects stop sequences (stops generating after "Observation:")
