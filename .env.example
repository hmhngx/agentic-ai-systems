# Anthropic API key for Claude inference and tool use
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API key (optional fallback for embeddings or GPT models)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Cohere API key for cross-encoder reranking in hybrid RAG pipelines
# Get yours at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key-here

# Tavily API key for web search in the research agent
# Get yours at: https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here

# Qdrant vector database URL (local default)
# Local: http://localhost:6333 | Cloud: https://your-cluster.cloud.qdrant.io
QDRANT_URL=http://localhost:6333

# Qdrant API key (leave blank for local Docker instance, required for Qdrant Cloud)
QDRANT_API_KEY=

# Absolute path to your local documents folder for ingestion pipelines
# Example (Windows): C:\Users\yourname\Documents\rag-corpus
DOCS_DIR=C:\path\to\your\documents

# Absolute path to local SQLite database file (with sqlite-vec extension)
# Example (Windows): C:\Users\yourname\data\rag.db
DB_PATH=C:\path\to\your\rag.db

# LangSmith API key for LLM tracing and evaluation (optional but recommended)
# Get yours at: https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key-here

# LangSmith project name for organizing traces
LANGSMITH_PROJECT=agentic-ai-systems
