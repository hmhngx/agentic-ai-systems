# Day 9 runs FULLY OFFLINE with deterministic mocks by default — no keys needed.
# Set the keys below to switch individual components to their real backends.

# --- LLM nodes (planner / researcher-summarizer / writer) via OpenRouter -------
# Set USE_LLM=1 AND provide a key to use real LLM calls. Otherwise mocks are used.
USE_LLM=0
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=your-model-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Researcher web search via Tavily -----------------------------------------
# Real search is used automatically when TAVILY_API_KEY is set. Force it off with
# USE_TAVILY=0 (the default mock search is deterministic and offline).
USE_TAVILY=1
TAVILY_API_KEY=your-tavily-key-here
