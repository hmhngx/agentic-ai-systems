# The Day 8 demo runs FULLY OFFLINE with no API key. Everything below is optional
# and only matters if you set USE_LLM=1 to swap the keyword sentiment classifier
# for a real LLM call through OpenRouter.

# Flip on the LLM-backed sentiment node (0 = offline keyword classifier, default).
USE_LLM=0

OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=your-model-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
